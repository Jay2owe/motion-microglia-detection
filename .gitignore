# This public repository deliberately tracks only the reusable source surface.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CITATION.cff
!/requirements.txt
!/run_pipeline.ps1
!/config.example.json
!/docs/
/docs/*
!/docs/ui/
/docs/ui/*
!/docs/ui/Motion-UI-*.png
!/code/
/code/*
!/code/*.py

# Downstream analysis package: source and example configuration only.
# The local analysis_config.json and everything under outputs/ stay private.
!/analysis_config.example.json
!/analysis_config.demo.json
!/analysis/
/analysis/*
!/analysis/*.py
!/analysis/pipelines/
/analysis/pipelines/*
!/analysis/pipelines/*.py
!/analysis/README.md
!/analysis/modules/
/analysis/modules/*
!/analysis/modules/*.py
!/analysis/figures/
/analysis/figures/*
!/analysis/figures/*.py
!/analysis/figures/SPATIAL_PLOTS.md
# Quality-control builders are kept apart from result figures.
!/analysis/figures/review/
/analysis/figures/review/*
!/analysis/figures/review/*.py
# The shared panel drawers every numbered figure imports. Without these the
# package clones but does not run.
!/analysis/figures/panels/
/analysis/figures/panels/*
!/analysis/figures/panels/*.py
