  "conditions": {
    "synthetic": true,
    "conditions": [
      {
        "name": "treated",
        "label": "Treated (invented)",
        "match": "_A\\d",
        "colour": "red"
      },
      {
        "name": "control",
        "label": "Control (invented)",
        "match": "_B\\d",
        "colour": "blue",
        "control": true
      }
    ]
  },
  "_comment_windows": "SYNTHETIC. Two halves of the same 49-hour recording, so the windowed machinery has something to chew on. Nothing changed at hour 24; these windows exist to exercise the code, not to describe an experiment.",
  "windows": [
    {
      "name": "first_day",
      "from_hours": 0.0,
      "to_hours": 24.0,
      "description": "SYNTHETIC. The first day of the recording."
    },
    {
      "name": "second_day",
      "from_hours": 24.0,
      "to_hours": 49.0,
      "baseline": "first_day",
      "description": "SYNTHETIC. The rest, against the first day."
    }
  ],
  "_comment_contrasts": "SYNTHETIC. The two 'movies' are the same recording under invented group labels, so every between-group result here must come out null - that is what makes it a test of the machinery rather than of an experiment. The second contrast is here to be refused: one subject a side is below the three-unit floor, and the refusal row is what proves the guard is wired to the data.",
  "contrasts": [
    {
      "name": "demo_by_condition_cell",
      "description": "SYNTHETIC. Cell-level, which is the pseudoreplicated unit; here to exercise the path, and null by construction.",
      "family": "demo_cell",
      "table": "cell_summary",
      "metrics": [
        "corrected_mean_median",
        "area_px_median",
        "turnover_index_median"
      ],
      "group_by": "condition",
      "groups": [
        "control",
        "treated"
      ],
      "unit": "cell",
      "test": "mannwhitney",
      "correction": "benjamini_hochberg",
      "alpha": 0.05
    },
    {
      "name": "demo_by_condition_subject",
      "description": "SYNTHETIC. The honest unit, which this design cannot support - one subject a side. Expected to write refusal rows.",
      "family": "demo_subject",
      "table": "cell_summary",
      "metrics": [
        "corrected_mean_median"
      ],
      "group_by": "condition",
      "groups": [
        "control",
        "treated"
      ],
      "unit": "subject",
      "aggregate": "median",
      "test": "mannwhitney",
      "correction": "benjamini_hochberg",
      "alpha": 0.05
    },
    {
      "name": "demo_second_day_against_first",
      "description": "SYNTHETIC. Each cell against itself across the two halves of the recording - a paired test, and the one shape this design can support.",
      "family": "demo_window",
      "table": "cell_summary_windowed",
      "metrics": [
        "turnover_index_median",
        "area_px_median"
      ],
      "group_by": "window",
      "groups": [
        "second_day",
        "first_day"
      ],
      "unit": "cell",
      "test": "wilcoxon",
      "correction": "benjamini_hochberg",
      "alpha": 0.05
    }
  ]
}
